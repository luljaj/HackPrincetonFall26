{
  "name": "web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "check-types": "next typegen && tsc --noEmit",
    "test": "npm run test:pipeline && npm run test:judge && npm run test:lab && npm run test:storage",
    "test:lab": "node --test app/lab/machine.test.ts app/lab/listen.test.ts app/lab/quick-judge.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx server/storage/seed.ts",
    "eval:pipeline": "tsx evals/pipeline/run.ts",
    "test:judge": "tsx --test server/judge/judge.test.ts",
    "test:pipeline": "tsx --test lib/contracts/contracts.test.ts server/pipeline/pipeline.test.ts server/pipeline/providers.test.ts evals/pipeline/eval.test.ts server/pipeline/http.test.ts",
    "test:storage": "vitest run server/storage/postgres.test.ts lib/parent"
  },
  "dependencies": {
    "@repo/ui": "*",
    "@tailwindcss/postcss": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.6",
    "openai": "^7.57.0",
    "postcss": "^8.5.23",
    "postgres": "^4.1.1",
    "radix-ui": "^1.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "^5.1.0"
  }
}
