# Copy to apps/web/.env.local and fill in. Never commit real values.
# None of these use the NEXT_PUBLIC_ prefix: they stay on the server.

# --- Pipeline (Luka) ---
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=gpt-transcribe
LUNA_MODEL=gpt-6-luna
PIPELINE_DEBUG=false

# --- Storage (dashboard owner) ---
# "postgres" uses DATABASE_URL and shares durable state with the parent dashboard.
# "memory" is allowed only in development/test; the dashboard then uses its sample fixture.
PIPELINE_STORE=postgres
# Managed Postgres connection string (pooled URL is fine; the client disables prepared statements).
DATABASE_URL=

# --- Parent dashboard ---
# If set, /parent asks for this code first. Leave empty only for local development.
PARENT_ACCESS_CODE=
# Name shown on the parent view ("Sam's learning moments"). First name or nickname only.
PARENT_CHILD_NAME=Sam

# If "true", /parent/live shows a "Reset demo" button that deletes every non-sample session
# and restores the sample. Local/demo machines only.
DEMO_TOOLS=false

# --- Live updates (Convex, live notifications only; Postgres stays the record) ---
# Written by `npx convex dev` in apps/web. Without them the dashboard polls every 2 s instead.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
# Server-only shared secret; set the same value on the deployment: npx convex env set LIVE_PUBLISH_SECRET <value>
LIVE_PUBLISH_SECRET=
