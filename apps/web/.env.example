# Server-side only. Never prefix secrets with NEXT_PUBLIC_.
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=gpt-transcribe
LUNA_MODEL=gpt-6-luna
# Memory is permitted only in development/test. Postgres is not implemented here.
PIPELINE_STORE=memory
# Both NODE_ENV=development and this exact opt-in are required for private debug data.
PIPELINE_DEBUG=false
